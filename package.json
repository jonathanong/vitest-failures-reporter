{
  "name": "vitest-failures-reporter",
  "version": "0.1.1",
  "description": "A minimal Vitest reporter that prints only failed tests and the final summary.",
  "homepage": "https://github.com/jonathanong/vitest-failures-reporter#readme",
  "bugs": {
    "url": "https://github.com/jonathanong/vitest-failures-reporter/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonathanong/vitest-failures-reporter.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check": "pnpm run build && pnpm run check:dist && pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run publint",
    "check:dist": "node scripts/check-dist.mjs",
    "check:lines": "node scripts/check-max-lines.mjs",
    "lint": "pnpm run oxlint && pnpm run oxfmt:check && pnpm run check:lines",
    "oxfmt": "oxfmt",
    "oxfmt:check": "oxfmt --check",
    "oxlint": "oxlint --deny-warnings",
    "publint": "pnpm run build && publint",
    "test": "vitest run --coverage --reporter=./src/index.mts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "25.8.0",
    "@vitest/coverage-v8": "4.1.6",
    "oxfmt": "0.50.0",
    "oxlint": "1.65.0",
    "publint": "0.3.21",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  },
  "peerDependencies": {
    "vitest": ">=4.0.0 <5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.1.2"
}
